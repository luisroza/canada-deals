# Local synthetic development only. Never put production credentials here.
ConnectionStrings__Database=Host=localhost;Port=5432;Database=canadadeals;Username=canadadeals;Password=canadadeals
ASPNETCORE_ENVIRONMENT=Development
Database__ApplyMigrations=true
Database__SeedDemoData=true
AffiliateHandoff__Enabled=true
AffiliateHandoff__AllowedHosts__0=demo.local
API_BASE_URL=http://localhost:5099
NEXT_PUBLIC_API_ORIGIN=http://localhost:5099
Email__Enabled=false
Email__Provider=Controlled
Email__FromDisplayName=Canada Deals
Email__PublicOrigin=http://localhost:3000
Email__AutoConfirmDevelopmentAccounts=true
Email__ConfirmationTokenHours=24
Email__MaxDeliveryAttempts=4
Email__EmergencyStop=false
# Production secrets must come from the deployment secret store:
# Email__ApiKey, Email__FromAddress, Email__WebhookSigningSecret
# DataProtection__CertificateBase64, DataProtection__CertificatePassword
