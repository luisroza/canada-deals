{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=canadadeals;Username=canadadeals;Password=canadadeals"
  },
  "Database": {
    "ApplyMigrations": false,
    "SeedDemoData": false
  },
  "DataProtection": {
    "PersistKeysToDatabase": true,
    "ApplicationName": "CanadaDeals"
  },
  "AffiliateHandoff": {
    "Enabled": false
  },
  "ProductFeatures": {
    "PriceHistoryEnabled": false,
    "PriceAlertsEnabled": false
  },
  "Affiliate": {
    "RevalidateHours": 168,
    "FailureRetryMinutes": 60,
    "Impact": { "Enabled": false },
    "Cj": { "Enabled": false }
  },
  "Rakuten": {
    "Enabled": false,
    "LiveDiscoveryEnabled": false,
    "CatalogImportEnabled": false,
    "DeepLinkEnabled": false,
    "ApiBaseUrl": "https://api.linksynergy.com",
    "TimeoutSeconds": 30,
    "RefreshSkewSeconds": 120,
    "MinimumRequestIntervalMilliseconds": 750,
    "ProductPageSize": 20,
    "MaximumPagesPerRun": 2
  },
  "Email": {
    "Enabled": false,
    "Provider": "Controlled",
    "FromDisplayName": "Canada Deals",
    "PublicOrigin": "http://localhost:3000",
    "AutoConfirmDevelopmentAccounts": true,
    "ConfirmationTokenHours": 24,
    "MaxDeliveryAttempts": 4,
    "EmergencyStop": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
